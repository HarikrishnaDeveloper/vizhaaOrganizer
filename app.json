{
  "expo": {
    "name": "Vizhaa_organizer",
    "slug": "Vizhaa_organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vizhaa.organizer"
    },
    "android": {
      "package": "com.vizhaa.organizer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vizhaa uses your photos to set your profile picture.",
          "cameraPermission": "Vizhaa uses the camera to take your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vizhaa uses your location to pin event venues on the map and find their address."
        }
      ]
    ]
  }
}
